<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RandomSeatNumber.Pages.Generation_Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RandomSeatNumber.Pages"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" 
                              MinWidth="600"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"
                              MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <ScrollView Grid.Column="0"
                    VerticalAlignment="Stretch"
                    Background="{StaticResource CardBackgroundFillColorDefault}"
                    BorderThickness="1,0,0,1"
                    BorderBrush="{StaticResource CardStrokeColorDefault}">
            <!--生成报告显示区域-->
            <StackPanel Padding="150, 20, 150, 20"
                        Spacing="12">
                <!--开发阶段提示-->
                <InfoBar IsOpen="True"
                         Severity="Warning"
                         Title="程序仍处开发阶段">
                    <TextBlock Margin="0,0,0,15"
                               TextWrapping="WrapWholeWords">
                        <Run>本程序仍处于开发阶段，大多数 GUI、程序功能等尚未完善。我们建议你通过以下方式了解更多本程序有关信息：</Run>
                        <LineBreak/>
                        <Hyperlink NavigateUri="https://github.com/GitBADASS/RandomSeatNumber">本程序的 GitHub 仓库</Hyperlink>
                        <!--<Hyperlink NavigateUri="">本程序的 GitHub 仓库</Hyperlink>-->
                    </TextBlock>
                </InfoBar>

                <!--生成结果 标题-->
                <TextBlock Style="{StaticResource TitleTextBlockStyle}">
                    生成结果
                </TextBlock>

                <!--生成结果 副标题-->
                <TextBlock>
                    显示最近一次生成的座位号。
                </TextBlock>

                <!--生成结果 显示区域-->
                <Grid Background="{StaticResource ApplicationPageBackgroundThemeBrush}"
                      BorderThickness="1"
                      BorderBrush="{StaticResource CardStrokeColorDefault}">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid BorderBrush="{StaticResource CardStrokeColorDefault}"
                          BorderThickness="0,0,0,1"
                          Padding="15">
                        <TextBlock x:Name="GnrtResTextBlock"
                                   Grid.Row="0"
                                   Style="{StaticResource DisplayTextBlockStyle}"
                                   TextAlignment="Center"
                                   CharacterSpacing="500"
                                   Text="???"/>
                    </Grid>

                    <CommandBar Grid.Row="1"
                                Background="{StaticResource CardBackgroundFillColorDefault}">
                        <AppBarButton Icon="Copy" Label="复制" Click="ResCopyButtonClicked"/>
                        <AppBarSeparator/>
                        <AppBarButton Icon="ZoomIn" Label="放大"  IsEnabled="False"/>
                        <AppBarButton Icon="ZoomOut" Label="缩小"  IsEnabled="False"/>

                        <CommandBar.Content>
                            <TextBlock Text="最新的生成结果" Margin="12,14"/>
                        </CommandBar.Content>
                    </CommandBar>
                </Grid>

                <!--历史结果 标题-->
                <TextBlock Style="{StaticResource TitleTextBlockStyle}">
                    历史结果
                </TextBlock>

                <!--历史结果 副标题-->
                <TextBlock>
                    显示一些生成结果的集合。
                </TextBlock>

                <Grid Background="{StaticResource ApplicationPageBackgroundThemeBrush}"
                      BorderBrush="{StaticResource CardStrokeColorDefault}"
                      BorderThickness="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <ListView x:Name="ResListView"
                              Grid.Row="0"
                              Background="{StaticResource ApplicationPageBackgroundThemeBrush}"
                              BorderBrush="{StaticResource CardStrokeColorDefault}"
                              BorderThickness="0,0,0,1"
                              Height="350"
                              ItemsSource="{x:Bind GeneratedResList, Mode=TwoWay}">
                    </ListView>

                    <CommandBar Grid.Row="1"
                                Background="{StaticResource CardBackgroundFillColorDefault}">
                        <AppBarButton Icon="Copy" Label="复制"
                                      Click="ListCopyButtonClicked"/>
                        <AppBarButton Icon="Delete" Label="清空"
                                      Click="ListClearButton_ClickAsync"/>
                        <AppBarSeparator/>
                        <AppBarButton Icon="ZoomIn" Label="放大" IsEnabled="False"/>
                        <AppBarButton Icon="ZoomOut" Label="缩小"  IsEnabled="False"/>

                        <CommandBar.Content>
                            <TextBlock Text="历史生成结果" Margin="12,14"/>
                        </CommandBar.Content>
                    </CommandBar>
                </Grid>
            </StackPanel>
        </ScrollView>

        <toolkit:GridSplitter Grid.Column="1"
                              Background="{StaticResource CardBackgroundFillColorDefault}"
                              BorderThickness="0,1,1,1"
                              BorderBrush="{StaticResource CardStrokeColorDefault}"
                              CornerRadius="6"
                              IsThumbVisible="False"/>

        <!--总体操作空间-->
        <Grid Grid.Column="2">
            <Grid VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!--操作菜单-->
                <ScrollView>
                    <StackPanel Padding="20" Spacing="10"
                                        HorizontalAlignment="Stretch">
                        <!--生成座位号的卡片-->
                        <toolkit:SettingsCard Grid.Row="0"
                                                  Header="生成随机座位号"
                                                  Description="点击旁边按钮可以随机生成座位号。">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xECC8;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <Button x:Name="GenerateBtn"
                                        Content="生成"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="Generate_Btn_ClickAsync"/>
                        </toolkit:SettingsCard>
                        <!--选择生成次数的卡片-->
                        <toolkit:SettingsCard Header="生成多个座位号"
                                              Description="在右侧输入需要的生成次数，并点击上方按钮生成。输入的数值需要在 1~50 之内。">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xECAA;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <NumberBox x:Name="NumberOfGenerateTime_Input"
                                       Value="{x:Bind GenerationFreq, Mode=TwoWay}"
                                       PlaceholderText="输入次数"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="1"
                                       LargeChange="5"/>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsExpander Header="其它生成设置"
                                                  HorizontalAlignment="Stretch"
                                                  Description="在此处设置包括去重等其它有关选项"
                                                  IsExpanded="True">
                            <!--选择是否去重的卡片-->
                            <toolkit:SettingsExpander.Items>
                                <toolkit:SettingsCard Header="选择是否去重"
                                                      Description="在右侧选择是否要去除重复生成的座号。">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE716;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <CheckBox x:Name="IsRepeatableCheckBox"
                                              Content="是否去重"
                                              IsChecked="{x:Bind IsRepeatable, Mode=TwoWay}"
                                              Unchecked="IsRepeatableCheckBox_Unchecked"/>
                                </toolkit:SettingsCard>
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>
                    </StackPanel>
                </ScrollView>

                <!--指令栏-->
                <Grid Grid.Row="1">
                    <CommandBar>
                        <AppBarToggleButton Icon="Shuffle" Label="Shuffle" Click="AppBarButton_Click" />
                        <AppBarToggleButton Icon="RepeatAll" Label="Repeat" Click="AppBarButton_Click"/>
                        <AppBarSeparator/>
                        <AppBarButton Icon="Back" Label="Back" Click="AppBarButton_Click"/>
                        <AppBarButton Icon="Stop" Label="Stop" Click="AppBarButton_Click"/>
                        <AppBarButton Icon="Play" Label="Play" Click="AppBarButton_Click"/>
                        <AppBarButton Icon="Forward" Label="Forward" Click="AppBarButton_Click"/>

                        <CommandBar.SecondaryCommands>
                            <AppBarButton Label="Like" Click="AppBarButton_Click"/>
                            <AppBarButton Label="Dislike" Click="AppBarButton_Click"/>
                        </CommandBar.SecondaryCommands>

                        <CommandBar.Content>
                            <TextBlock Text="编组轮换操作" Margin="12,14"/>
                        </CommandBar.Content>
                    </CommandBar>
                </Grid>
            </Grid>
        </Grid>
        <!--提示内容-->
        <TeachingTip x:Name="GnrtFreqTeachingTip"
                    Target="{x:Bind NumberOfGenerateTime_Input}"
                    Title="输入合法的数值"
                    Subtitle="请按照规范输入一个位于 1~50（含两端）范围内的整数。"
                    IsOpen="False">
            <TeachingTip.IconSource>
                <SymbolIconSource Symbol="Keyboard"/>
            </TeachingTip.IconSource>
        </TeachingTip>
    </Grid>
</Page>
